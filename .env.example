# Polymarket API Configuration
# Optional for dry-run mode, required for live trading
POLYMARKET_API_KEY=
POLYMARKET_PRIVATE_KEY=

# Trading Parameters
MIN_PROFIT_THRESHOLD=0.01
MAX_POSITION_SIZE=100.0

# Market Selection Filters (all optional)
# MIN_MARKET_VOLUME: Minimum 24h volume to consider (filters out illiquid markets)
# MAX_MARKET_VOLUME: Maximum 24h volume to consider (filters out whale-dominated markets)
# MAX_MARKETS: Maximum number of markets to monitor (resource management)
# If unset, no filtering is applied (monitors all active markets)
#
# Example: Target mid-tier markets (avoid hyper-competitive top tier)
# MIN_MARKET_VOLUME=1000
# MAX_MARKET_VOLUME=500000
# MAX_MARKETS=100

# Logging Configuration
LOG_LEVEL=info
RUST_LOG=arbitrage_bot=debug,info

# CSV Output
CSV_OUTPUT_PATH=./opportunities.csv
